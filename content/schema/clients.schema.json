{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "clients.schema.json",
  "title": "Client workload requests (content/clients.json)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "request", "aiNeed", "choices", "source", "confidence"],
    "properties": {
      "id": { "$ref": "common.schema.json#/definitions/id" },
      "name": { "type": "string", "maxLength": 40 },
      "request": { "type": "string", "maxLength": 200 },
      "aiNeed": { "enum": ["needed", "partly", "not-needed", "not-ai"] },
      "choices": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "$ref": "common.schema.json#/definitions/choice" } },
      "when": { "$ref": "common.schema.json#/definitions/condition" },
      "weight": { "type": "number", "minimum": 0 },
      "quizId": { "$ref": "common.schema.json#/definitions/id" },
      "source": { "type": "string", "minLength": 3 },
      "confidence": { "$ref": "common.schema.json#/definitions/confidence" },
      "slice": { "type": "boolean" }
    }
  }
}
