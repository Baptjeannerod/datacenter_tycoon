{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "events.schema.json",
  "title": "Events (content/events.json)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "title", "body", "kind", "themes", "choices", "source", "confidence"],
    "properties": {
      "id": { "$ref": "common.schema.json#/definitions/id" },
      "title": { "type": "string", "maxLength": 50 },
      "body": { "type": "string", "maxLength": 240 },
      "kind": { "enum": ["random", "consequence", "milestone"] },
      "themes": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/definitions/theme" } },
      "when": { "$ref": "common.schema.json#/definitions/condition" },
      "weight": { "type": "number", "minimum": 0 },
      "repeatable": { "type": "boolean" },
      "choices": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "common.schema.json#/definitions/choice" } },
      "quizId": { "$ref": "common.schema.json#/definitions/id" },
      "source": { "type": "string", "minLength": 3 },
      "confidence": { "$ref": "common.schema.json#/definitions/confidence" },
      "slice": { "type": "boolean" }
    }
  }
}
